# SynapseMed API — development environment
# Copy to .env and fill in values. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# SQLite for local dev. Change to postgresql:// for staging/production.
DATABASE_URL="file:./dev.db"

# JWT — CHANGE THIS before any non-local deployment
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYMENT

# Safety flags — keep both false until all production gates are passed
USE_SYNTHETIC_DATA=true
ENABLE_REAL_CLAIM_SUBMISSION=false
ENABLE_REAL_PAYMENTS=false

# CORS
APP_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# IBM Cloud — all IBM services are optional.
# Leave values empty to use built-in mock implementations.
# Never commit credentials to source control.
# ─────────────────────────────────────────────────────────

# IBM Cloudant (NoSQL document store)
# Service URL: IBM Cloud dashboard → Cloudant instance → Credentials
# Plan: Lite tier available (1 GB storage, limited requests)
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DB_NAME=synapsemed

# IBM Cloud Object Storage (file/document storage)
# Endpoint: https://s3.<region>.cloud-object-storage.appdomain.cloud
# HMAC credentials are required for presigned upload/download URLs.
# Generate from: COS instance → Service credentials → New credential → Include HMAC key
IBM_COS_ENDPOINT=
IBM_COS_BUCKET=
IBM_COS_API_KEY=
IBM_COS_SERVICE_INSTANCE_CRN=
IBM_COS_REGION=us-south
IBM_COS_HMAC_ACCESS_KEY_ID=
IBM_COS_HMAC_SECRET_ACCESS_KEY=
# STORAGE_PROVIDER=ibm-cos   # Uncomment to enable COS (auto-detected when IBM_COS_ENDPOINT is set)

# IBM Watson Assistant (conversational AI / patient intake chatbot)
# URL: IBM Cloud dashboard → Watson Assistant → Credentials → Service URL
# Assistant ID: Watson Assistant workspace → Settings → API details
WATSON_ASSISTANT_URL=
WATSON_ASSISTANT_API_KEY=
WATSON_ASSISTANT_ASSISTANT_ID=
# WATSON_ASSISTANT_API_VERSION=2023-06-15   # Optional; defaults to 2023-06-15

# IBM Watson Speech to Text (clinical dictation/transcription)
# URL: IBM Cloud dashboard → Speech to Text → Credentials → Service URL
# Model: en-US_BroadbandModel | en-GB_BroadbandModel | en-AU_BroadbandModel
# Note: There is no dedicated en-ZA model; use en-GB or en-US for SA English.
WATSON_SPEECH_TO_TEXT_URL=
WATSON_SPEECH_TO_TEXT_API_KEY=
WATSON_SPEECH_TO_TEXT_MODEL=en-US_BroadbandModel

# IBM watsonx.ai (foundation model inference)
# API key: IBM Cloud IAM API key (same key can be reused across IBM services)
# Project ID: watsonx.ai dashboard → Projects → your project → Manage → General
# Model ID: ibm/granite-13b-chat-v2 | ibm/granite-3-8b-instruct | meta-llama/llama-3-8b-instruct
# URL: https://us-south.ml.cloud.ibm.com (or nearest region)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─────────────────────────────────────────────────────────
# AI gateway — controls which AI provider is used globally.
# Per-practice overrides are stored in PracticeAISettings.
# ─────────────────────────────────────────────────────────
# AI_PROVIDER: mock | watsonx | gemini | opencode
AI_PROVIDER=mock
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=

# Google Gemini (free tier — alternative AI provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Opencode (free AI endpoint — alternative AI provider)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────
# Auth adapter (local = JWT/bcrypt built-in)
# ─────────────────────────────────────────────────────────
AUTH_PROVIDER=local

# ─────────────────────────────────────────────────────────
# Payment provider (mock in dev)
# ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────
# Switch provider (mock until authorised by a real SA switch provider)
# ─────────────────────────────────────────────────────────
SWITCH_PROVIDER=mock
SWITCH_ENVIRONMENT=sandbox
SWITCH_API_BASE_URL=
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=
SWITCH_WEBHOOK_SECRET=

# SynapseMed API — development environment
# Copy to .env and fill in values. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# SQLite for local dev. Change to postgresql:// for staging/production.
DATABASE_URL="file:./dev.db"

# JWT — CHANGE THIS before any non-local deployment
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYMENT

# Safety flags — keep both false until all production gates are passed
USE_SYNTHETIC_DATA=true
ENABLE_REAL_CLAIM_SUBMISSION=false
ENABLE_REAL_PAYMENTS=false

# CORS
APP_BASE_URL=http://localhost:3000

# Auth adapter (local = JWT/bcrypt built-in)
AUTH_PROVIDER=local

# Payment provider (mock in dev)
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Switch provider (mock until authorised by a real SA switch provider)
SWITCH_PROVIDER=mock
SWITCH_ENVIRONMENT=sandbox
SWITCH_API_BASE_URL=
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=
SWITCH_WEBHOOK_SECRET=

# AI gateway (mock until an eligible provider is configured)
AI_PROVIDER=mock
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=

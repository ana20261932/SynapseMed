# Example only. Never put real secrets in this file or commit a populated .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Database adapter — set values only after choosing a service.
DATABASE_PROVIDER=local
DATABASE_URL=
CLOUDANT_URL=
CLOUDANT_API_KEY=

# Identity provider adapter
AUTH_PROVIDER=local
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Payment provider: mock in development by default.
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Switch integration: mock until authorised.
SWITCH_PROVIDER=mock
SWITCH_ENVIRONMENT=sandbox
SWITCH_API_BASE_URL=
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=
SWITCH_WEBHOOK_SECRET=

# AI gateway: use mock until an eligible provider is configured.
AI_PROVIDER=mock
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=

# Safety defaults
USE_SYNTHETIC_DATA=true
ENABLE_REAL_CLAIM_SUBMISSION=false
ENABLE_REAL_PAYMENTS=false

# IBM Cloudant (optional - Lite: 1GB, 20 reads/sec, 10 writes/sec)
CLOUDANT_URL=
CLOUDANT_API_KEY=
CLOUDANT_DB_NAME=synapsemed

# IBM Cloud Object Storage (optional - Lite: 25GB)
OBJECT_STORAGE_PROVIDER=mock
IBM_COS_ENDPOINT=
IBM_COS_BUCKET=
IBM_COS_INSTANCE_ID=
IBM_COS_API_KEY=
IBM_COS_SERVICE_INSTANCE_CRN=

# IBM Watson Assistant (optional - Lite: 10,000 API interactions/month)
WATSON_ASSISTANT_URL=
WATSON_ASSISTANT_API_KEY=
WATSON_ASSISTANT_ASSISTANT_ID=

# IBM Watson Speech to Text (optional - Lite: 500 minutes/month)
WATSON_SPEECH_TO_TEXT_URL=
WATSON_SPEECH_TO_TEXT_API_KEY=

# ERPNext Healthcare Integration (optional)
ERPNEXT_URL=http://localhost:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_COMPANY=
ERPNEXT_PROVIDER=mock

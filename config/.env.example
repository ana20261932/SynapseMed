# Example only. Never put real secrets in this file or commit a populated .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# Database adapter — set values only after choosing a service.
DATABASE_PROVIDER=local
DATABASE_URL=
CLOUDANT_URL=
CLOUDANT_API_KEY=

# Identity provider adapter
AUTH_PROVIDER=local
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Payment provider: mock in development by default.
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Switch integration: mock until authorised.
SWITCH_PROVIDER=mock
SWITCH_ENVIRONMENT=sandbox
SWITCH_API_BASE_URL=
SWITCH_CLIENT_ID=
SWITCH_CLIENT_SECRET=
SWITCH_WEBHOOK_SECRET=

# AI gateway: use mock until an eligible provider is configured.
AI_PROVIDER=mock
AI_MODEL=
AI_API_BASE_URL=
AI_API_KEY=

# Safety defaults
USE_SYNTHETIC_DATA=true
ENABLE_REAL_CLAIM_SUBMISSION=false
ENABLE_REAL_PAYMENTS=false
